#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for suite in drover_tests drover_ui_tests; do
  mkdir -p "$ROOT/build/tests/$suite"
  cd "$ROOT/build/tests/$suite"
  qmake6 "$ROOT/tests/$suite.pro" >/dev/null
  make -j"$(nproc)" >/dev/null
  QT_QPA_PLATFORM=offscreen ./"$suite"
done

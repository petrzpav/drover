pkgname=drover
pkgver=0.4.0
pkgrel=1
pkgdesc='A floating indicator of your herdr agents, on every workspace'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'libvterm' 'herdr')
optdepends=('fresh-editor: the editor beside an agent (Alt+E)')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/drover "$pkgdir/usr/bin/drover"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/drover.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/drover.svg"
  install -Dm644 "$startdir/drover.desktop" "$pkgdir/usr/share/applications/drover.desktop"
}
